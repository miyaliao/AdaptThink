#!/bin/bash
#PBS -P ds_ccds_wei.lu
#PBS -q gpu_ded
#PBS -l select=1:ncpus=2:ngpus=1:mem=16gb
#PBS -l walltime=02:00:00
#PBS -N nt_joint

# Two shots in one queue slot:
#   A. probe with pooled features (mean over prompt tokens, last 4 layers) - the
#      previous probe used only the final token, which is a poor summary.
#   B. joint SFT: decision BCE on all problems + answer language-modelling on every
#      problem that already has a compliant, correct NoThinking answer.
#
# Submit:
#     qsub -v REPO=$PWD,ENV_ACTIVATE=$HOME/activate_nt.sh scripts/lab_joint.pbs

set -euo pipefail

REPO="${REPO:-$HOME/AdaptThink}"
MODULES="${MODULES:-anaconda/2025 cuda/13.0}"
ENV_ACTIVATE="${ENV_ACTIVATE:-}"

cd "$REPO"
for m in $MODULES; do module load "$m" 2>/dev/null || echo "WARNING: module $m not available"; done
[ -n "$ENV_ACTIVATE" ] && source "$ENV_ACTIVATE"
export PYTHONNOUSERSITE=1 TOKENIZERS_PARALLELISM=false

echo "PBS job: ${PBS_JOBID:-local}"; echo "Node: $(hostname)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

echo "=== A1: pooled features ==="
[ -f outputs/hidden_means/train.npz ] || python -u scripts/extract_hidden.py \
  --labels results/router_labels_1p5b_compliant/all_3000_labels.jsonl \
  --out outputs/hidden_means/train.npz --pooling mean --layers last4
[ -f outputs/hidden_means/val.npz ] || python -u scripts/extract_hidden.py \
  --labels results/val_450_labels.jsonl --out outputs/hidden_means/val.npz \
  --pooling mean --layers last4
[ -f outputs/hidden_means/test.npz ] || python -u scripts/extract_hidden.py \
  --labels results/test_485_labels.jsonl --out outputs/hidden_means/test.npz \
  --pooling mean --layers last4

echo "=== A2: probe on pooled features ==="
python -u scripts/train_probe.py \
  --train outputs/hidden_means/train.npz --val outputs/hidden_means/val.npz \
  --test outputs/hidden_means/test.npz --out-dir results/probe_pooled

echo "=== B: joint SFT (decision + answers) ==="
python -u scripts/train_router_sft.py \
  --labels results/router_labels_1p5b_compliant/all_3000_labels.jsonl \
  --val-labels results/val_450_labels.jsonl \
  --nothinking-dir outputs/nothinking_train_repaired \
  --response-weight 1.0 --answer-scope correct \
  --epochs 2 --lr 1e-4 --output-dir outputs/lora_router_joint

echo "JOINT_DONE"
