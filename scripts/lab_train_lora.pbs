#!/bin/bash
#PBS -P ds_ccds_wei.lu
#PBS -q gpu_ded
#PBS -l select=1:ncpus=8:ngpus=1
#PBS -l walltime=01:00:00
#PBS -N nt_train_lora

# Train the Internal Router LoRA (first-token decision only).
#
# One H200 is far more than this needs (1.5B model, LoRA r=16, prompts ~90 tokens,
# 2,400 training examples); the walltime is generous because the cluster queue is
# the only slow part.
#
# Submit:
#     qsub -v REPO=$PWD,ENV_ACTIVATE=$HOME/activate_nt.sh scripts/lab_train_lora.pbs
# Cost-aware variant (default lam=0.02) vs accuracy-only (lam=0):
#     qsub -v REPO=$PWD,ENV_ACTIVATE=$HOME/activate_nt.sh,LAM=0,SUFFIX=lam0 scripts/lab_train_lora.pbs
#
# Output: outputs/lora_router_<suffix>/ (adapter + train_report.json)

set -euo pipefail

REPO="${REPO:-$HOME/AdaptThink}"
MODULES="${MODULES:-anaconda/2025 cuda/13.0}"
ENV_ACTIVATE="${ENV_ACTIVATE:-}"
LAM="${LAM:-0.02}"
EPOCHS="${EPOCHS:-3}"
LR="${LR:-2e-4}"
SUFFIX="${SUFFIX:-lam002}"

cd "$REPO"
for m in $MODULES; do
  module load "$m" 2>/dev/null || echo "WARNING: module $m not available"
done
if [ -n "$ENV_ACTIVATE" ]; then
  # shellcheck disable=SC1090
  source "$ENV_ACTIVATE"
fi
export PYTHONNOUSERSITE=1
export TOKENIZERS_PARALLELISM=false

echo "PBS job: ${PBS_JOBID:-local}"
echo "Node: $(hostname)"
echo "lam=$LAM epochs=$EPOCHS lr=$LR suffix=$SUFFIX"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

python -u scripts/train_decision_lora.py \
  --lam "$LAM" --epochs "$EPOCHS" --lr "$LR" \
  --output-dir "outputs/lora_router_${SUFFIX}"

echo "LORA_TRAIN_DONE outputs/lora_router_${SUFFIX}"
